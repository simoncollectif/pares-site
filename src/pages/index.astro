---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Monogram from '../components/Monogram.astro';
import Photo from '../components/Photo.astro';
import schaduwen from '../assets/beeld/schaduwen-viaduct.jpg';
import havana from '../assets/beeld/havana-straat.jpg';
import favelaUitzicht from '../assets/beeld/favela-uitzicht.jpg';

const posts = (await getCollection('verhalen', ({ data }) => !data.draft))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 3);
---

<Base>
	<section class="hero wrap">
		<div class="hero-text">
			<p class="eyebrow">Pares in campo</p>
			<h1>Gelijken op het veld.</h1>
			<p class="lead">
				Op het veld maakt het niet uit waar je vandaan komt, welke taal je thuis spreekt of wat
				je ouders verdienen. Wie de bal wil, doet mee. PARES vertelt de verhalen van dat veld,
				en werkt eraan dat meer kinderen er een plek op krijgen.
			</p>
			<a class="cta" href="/verhalen/">Lees de verhalen</a>
		</div>
		<div class="hero-mark" aria-hidden="true">
			<Monogram size={260} variant="chrome" />
		</div>
	</section>

	<Photo
		src={schaduwen}
		alt="Vier kinderen rennen achter een bal aan onder een viaduct, met lange schaduwen op het beton"
		ai
		loading="eager"
	/>

	<section class="pillars">
		<div>
			<span class="num">01</span>
			<h2>Het pleintje</h2>
			<p>Een veldje in de wijk, twee jassen als doel. Daar leren de meeste kinderen voetballen.</p>
		</div>
		<div>
			<span class="num">02</span>
			<h2>De verhalen</h2>
			<p>Clubs, trainers en kinderen die laten zien wat voetbal met een buurt doet.</p>
		</div>
		<div>
			<span class="num">03</span>
			<h2>Het doel</h2>
			<p>Meer kinderen op het veld, met voetbaldagen op pleintjes waar het nodig is.</p>
		</div>
	</section>

	<section class="duo">
		<Photo src={havana} alt="Een jongen gooit een bal op in een straat met afbladderende muren, drie kinderen kijken toe" ai />
		<Photo src={favelaUitzicht} alt="Kinderen van achteren gezien in een steeg, met een favela tegen de heuvel" ai />
	</section>

	{
		posts.length > 0 && (
			<section class="latest wrap">
				<h2>Laatste verhalen</h2>
				<ul>
					{posts.map((post) => (
						<li>
							<a href={`/verhalen/${post.id}/`}>
								<span class="title">{post.data.title}</span>
								<span class="desc">{post.data.description}</span>
							</a>
						</li>
					))}
				</ul>
			</section>
		)
	}

	<section class="quote wrap">
		<p><em>Pares</em> is Latijn voor gelijken.</p>
		<a href="/verhalen/waarom-pares/">Waarom deze naam</a>
	</section>
</Base>

<style>
	.hero {
		background: var(--ink);
		color: var(--paper);
		display: grid;
		grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
		align-items: center;
		gap: 40px;
		padding-block: clamp(64px, 12vh, 140px);
	}
	.eyebrow { color: var(--accent-on-dark); font-weight: 600; font-size: 15px; margin: 0 0 20px; }
	h1 { font-size: clamp(52px, 9vw, 120px); margin: 0 0 32px; }
	.lead { max-width: 540px; color: #d4d4d4; margin: 0 0 32px; }
	.cta {
		display: inline-block;
		border: 1px solid var(--paper);
		padding: 12px 20px;
		font-weight: 600;
		text-decoration: none;
	}
	.cta:hover { background: var(--paper); color: var(--ink); }
	.hero-mark { display: flex; justify-content: center; }
	.hero-mark :global(svg) { width: min(100%, 260px); height: auto; }

	.pillars {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		border-bottom: 1px solid var(--line);
	}
	.pillars div { padding: 40px var(--gutter); }
	.pillars div + div { border-left: 1px solid var(--line); }
	.num { font-family: var(--font-head); font-weight: 600; color: var(--accent); font-size: 15px; }
	h2 { font-size: 30px; margin: 12px 0 12px; }
	.pillars p { margin: 0; color: var(--muted); }

	.duo { display: grid; grid-template-columns: 1fr 1fr; border-bottom: 1px solid var(--line); }
	.duo :global(.photo + .photo) { border-left: 1px solid var(--line); }

	.latest { padding-block: 56px 0; }
	.latest ul { list-style: none; padding: 0; margin: 24px 0 0; border-top: 1px solid var(--line); }
	.latest li { border-bottom: 1px solid var(--line); }
	.latest a { display: block; padding: 22px 0; text-decoration: none; }
	.latest .title { display: block; font-family: var(--font-head); font-weight: 700; font-size: 24px; letter-spacing: -0.02em; }
	.latest .desc { color: var(--muted); font-size: 16px; }
	.latest a:hover .title { color: var(--accent); }

	.quote {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 24px;
		flex-wrap: wrap;
		padding-block: 56px;
	}
	.quote p { font-family: var(--font-head); font-weight: 700; font-size: clamp(28px, 4vw, 48px); letter-spacing: -0.03em; margin: 0; }
	.quote em { color: var(--accent); }
	.quote a { font-weight: 600; text-underline-offset: 4px; }
	.quote a:hover { color: var(--accent); }

	@media (max-width: 760px) {
		.hero { grid-template-columns: 1fr; }
		.hero-mark { justify-content: flex-start; }
		.hero-mark :global(svg) { width: 120px; }
		.pillars { grid-template-columns: 1fr; }
		.duo { grid-template-columns: 1fr; }
		.pillars div + div { border-left: 0; border-top: 1px solid var(--line); }
	}
</style>
