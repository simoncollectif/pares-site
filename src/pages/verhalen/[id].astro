---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
	const posts = await getCollection('verhalen', ({ data }) => !data.draft);
	return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={`${post.data.title}. PARES`} description={post.data.description}>
	<article>
		<p class="date">{post.data.date.toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' })}</p>
		<h1>{post.data.title}</h1>
		<Content />
	</article>
</Base>

<style>
	article { max-width: 640px; margin: 10vh 0; }
	.date { color: var(--accent); font-size: 13px; text-transform: uppercase; letter-spacing: 0.18em; }
	h1 {
		font-size: clamp(36px, 6vw, 72px);
		font-weight: 800;
		font-stretch: 112%;
		text-transform: uppercase;
		line-height: 1;
		margin: 0 0 32px;
	}
</style>
