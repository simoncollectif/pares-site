---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
	const posts = await getCollection('verhalen', ({ data }) => !data.draft);
	return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={`${post.data.title}. PARES`} description={post.data.description}>
	<article class="wrap">
		<p class="date">{post.data.date.toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' })}</p>
		<h1>{post.data.title}</h1>
		<Content />
	</article>
</Base>

<style>
	article { max-width: calc(680px + 2 * var(--gutter)); margin: 10vh 0; }
	.date { color: var(--accent); font-weight: 600; font-size: 15px; }
	h1 { font-size: clamp(40px, 6vw, 72px); margin: 0 0 32px; }
</style>
