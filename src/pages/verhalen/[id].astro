---
import { getCollection, render } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import Cover from '../../components/Cover.astro';
import Card from '../../components/Card.astro';
import Reacties from '../../components/Reacties.astro';
import Nieuwsbrief from '../../components/Nieuwsbrief.astro';
import { rubriekNaam } from '../../data/rubrieken';

export async function getStaticPaths() {
	const posts = await getCollection('verhalen', ({ data }) => !data.draft);
	return posts.map((post) => ({ params: { id: post.id }, props: { post, alle: posts } }));
}

const { post, alle } = Astro.props;
const { Content } = await render(post);
const { title, description, date, rubriek, bron, image, imageAlt, imageAi } = post.data;

const woorden = (post.body ?? '').split(/\s+/).filter(Boolean).length;
const leestijd = Math.max(1, Math.round(woorden / 220));
const ogImage = image ? (await getImage({ src: image, width: 1200, format: 'jpg' })).src : '/og-default.png';
const datum = date.toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' });

const meer = alle
	.filter((p) => p.id !== post.id)
	.sort((a, b) => Number(b.data.rubriek === rubriek) - Number(a.data.rubriek === rubriek) || b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 3);

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: title,
	description,
	datePublished: date.toISOString(),
	dateModified: date.toISOString(),
	inLanguage: 'nl-NL',
	articleSection: rubriekNaam(rubriek),
	image: [new URL(ogImage, Astro.site).toString()],
	author: { '@type': 'Organization', name: 'PARES', url: 'https://paresfootball.com/' },
	publisher: { '@type': 'Organization', name: 'PARES', logo: { '@type': 'ImageObject', url: 'https://paresfootball.com/favicon.svg' } },
	mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).toString(),
};
---

<Base title={post.data.seoTitle ?? title} description={description} type="article" image={ogImage} jsonLd={jsonLd}>
	<header class="opener">
		{image ? <Photo src={image} alt={imageAlt ?? ''} ai={imageAi} loading="eager" /> : <Cover titel={title} label={rubriekNaam(rubriek)} groot />}
	</header>

	<article class="artikel wrap">
		<p class="meta">
			<a href={`/rubriek/${rubriek}/`}>{rubriekNaam(rubriek)}</a>
			<span>{datum}</span>
			<span>{leestijd} min lezen</span>
		</p>
		{image && <h1>{title}</h1>}
		<p class="lead">{description}</p>
		{post.data.affiliate && <p class="affiliate">Dit stuk bevat affiliate-links. Koop je via zo'n link, dan krijgt PARES een klein deel van het bedrag. Jij betaalt niets extra.</p>}
		<div class="tekst">
			<Content />
		</div>
		{bron && <p class="bron">Bron: <a href={bron.url} rel="noopener">{bron.naam}</a></p>}
		<Reacties id={post.id} />
	</article>

	<section class="meer">
		<h2 class="wrap">Lees ook</h2>
		<div class="meer-grid">
			{meer.map((p) => <Card post={p} />)}
		</div>
	</section>

	<Nieuwsbrief />
</Base>

<style>
	.artikel { max-width: calc(720px + 2 * var(--gutter)); margin: 0 auto; padding-block: 48px 64px; }
	.meta { display: flex; flex-wrap: wrap; gap: 8px 18px; font-weight: 600; font-size: 14px; margin: 0 0 24px; }
	.meta a { background: var(--ink); color: var(--paper); text-decoration: none; padding: 3px 10px; }
	.meta a:hover { background: var(--accent); }
	.meta span { color: var(--muted); font-weight: 500; align-self: center; }
	h1 { font-size: clamp(44px, 7vw, 92px); margin: 0 0 24px; }
	.lead { font-family: var(--font-head); font-weight: 600; font-size: clamp(22px, 2.4vw, 28px); line-height: 1.3; letter-spacing: -0.015em; margin: 0 0 40px; }
	.tekst :global(p) { font-size: 19px; line-height: 1.75; margin: 0 0 22px; }
	.tekst :global(> p:first-child::first-letter) {
		float: left;
		font-family: var(--font-head);
		font-weight: 900;
		font-size: 5.2em;
		line-height: 0.82;
		padding: 6px 10px 0 0;
		color: var(--accent);
	}
	.tekst :global(h2) { font-size: clamp(30px, 3.4vw, 40px); margin: 56px 0 18px; }
	.tekst :global(blockquote) {
		margin: 40px 0;
		padding: 0 0 0 24px;
		border-left: 4px solid var(--accent);
		font-family: var(--font-head);
		font-weight: 700;
		font-size: clamp(24px, 3vw, 34px);
		line-height: 1.15;
		letter-spacing: -0.02em;
	}
	.tekst :global(blockquote p) { font-size: inherit; line-height: inherit; margin: 0; }
	.tekst :global(ul), .tekst :global(ol) { font-size: 19px; line-height: 1.7; padding-left: 22px; }
	.tekst :global(li) { margin-bottom: 8px; }
	.tekst :global(a) { text-decoration-color: var(--accent); text-underline-offset: 3px; text-decoration-thickness: 2px; }
	.affiliate { font-size: 14px; color: var(--muted); border-left: 3px solid var(--accent); padding: 4px 0 4px 12px; margin: -16px 0 32px; }
	.bron { margin-top: 40px; padding-top: 16px; border-top: 1px solid var(--line); color: var(--muted); font-size: 15px; }
	.meer { border-top: 1px solid var(--line); padding-top: 40px; }
	.meer h2 { font-size: clamp(30px, 4vw, 48px); margin: 0 0 16px; }
	.meer-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--line); }
	.meer-grid > :global(*:not(:last-child)) { border-right: 1px solid var(--line); }
	@media (max-width: 760px) {
		.meer-grid { grid-template-columns: 1fr; }
		.meer-grid > :global(*) { border-right: 0 !important; border-bottom: 1px solid var(--line); }
	}
</style>
