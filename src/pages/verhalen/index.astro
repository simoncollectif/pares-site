---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CardGrid from '../../components/CardGrid.astro';
import RubriekNav from '../../components/RubriekNav.astro';

const posts = (await getCollection('verhalen', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base title="Verhalen" description="Goed nieuws uit de voetbalwereld: clubs, goede doelen, pleintjes, acties en mooie voetbalfoto's.">
	<header class="wrap intro">
		<h1>Verhalen</h1>
		<p>Goed nieuws van het veld. Clubs, goede doelen, pleintjes, acties en mooie beelden.</p>
	</header>
	<RubriekNav />
	<CardGrid posts={posts} />
</Base>

<style>
	.intro { padding-block: 10vh 32px; }
	h1 { font-size: clamp(44px, 7vw, 88px); margin: 0 0 16px; }
	.intro p { color: var(--muted); max-width: 560px; margin: 0; }
</style>
