---
import Monogram from '../components/Monogram.astro';

interface Props {
	title?: string;
	description?: string;
}
const {
	title = 'PARES. Gelijken op het veld',
	description = 'PARES vertelt de verhalen van het veld en werkt eraan dat meer kinderen kunnen voetballen. Pares in campo: gelijken op het veld.',
} = Astro.props;
---

<html lang="nl">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@600;700&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<header class="site-header">
			<a href="/" class="brand"><Monogram size={34} /><span>Pares</span></a>
			<nav><a href="/verhalen/">Verhalen</a><a href="/pleintjes/">Pleintjes</a></nav>
		</header>
		<main><slot /></main>
		<footer class="site-footer">
			<span><em>Pares in campo</em>, gelijken op het veld</span>
			<span>© {new Date().getFullYear()} PARES</span>
		</footer>
	</body>
</html>

<style is:global>
	/* Merk: clean zwart-wit, wijnrood alleen als accent. Kopletter Schibsted Grotesk, tekst Plus Jakarta Sans. Geen hoofdletters in kopjes. */
	:root {
		--ink: #0b0b0b;
		--paper: #ffffff;
		--muted: #5c5c5c;
		--line: #0b0b0b;
		--accent: #7a1f2e;
		--accent-on-dark: #c0394f;
		--font-head: 'Schibsted Grotesk', system-ui, sans-serif;
		--font-body: 'Plus Jakarta Sans', system-ui, sans-serif;
		--gutter: clamp(16px, 4vw, 40px);
	}
	* { box-sizing: border-box; }
	html, body { margin: 0; background: var(--paper); color: var(--ink); }
	body {
		font-family: var(--font-body);
		font-size: 17px;
		line-height: 1.65;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}
	main { flex: 1; }
	a { color: inherit; }
	h1, h2, h3 {
		font-family: var(--font-head);
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1;
	}
	.wrap { padding-inline: var(--gutter); }
	.site-header, .site-footer {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 14px var(--gutter);
		font-size: 15px;
	}
	.site-header { border-bottom: 1px solid var(--line); }
	.site-header a { text-decoration: none; }
	.site-header nav { display: flex; gap: 24px; }
	.site-header nav a:hover { color: var(--accent); }
	.brand {
		display: flex;
		align-items: center;
		gap: 10px;
		font-family: var(--font-head);
		font-weight: 700;
		font-size: 20px;
		letter-spacing: -0.02em;
	}
	.site-footer { border-top: 1px solid var(--line); color: var(--muted); font-size: 14px; gap: 16px; flex-wrap: wrap; }
</style>
