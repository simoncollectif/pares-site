---
// Monogram P: een P in een cirkel. 'chrome' is voor donkere vlakken op de site.
interface Props {
	size?: number;
	variant?: 'ink' | 'light' | 'chrome';
	class?: string;
}
const { size = 40, variant = 'ink', class: className } = Astro.props;
const id = `chrome-${Math.random().toString(36).slice(2, 8)}`;
const stroke = variant === 'chrome' ? `url(#${id})` : variant === 'light' ? '#ffffff' : 'currentColor';
---

<svg
	class={className}
	width={size}
	height={size}
	viewBox="0 0 64 64"
	role="img"
	aria-label="PARES"
	fill="none"
	stroke={stroke}
>
	{
		variant === 'chrome' && (
			<defs>
				<linearGradient id={id} x1="0" y1="0" x2="0" y2="1">
					<stop offset="0" stop-color="#ffffff" />
					<stop offset="0.38" stop-color="#c7cad0" />
					<stop offset="0.5" stop-color="#6e727a" />
					<stop offset="0.62" stop-color="#e9ebee" />
					<stop offset="1" stop-color="#8d9199" />
				</linearGradient>
			</defs>
		)
	}
	<circle cx="32" cy="32" r="29" stroke-width="2.5" />
	<path d="M25 47V17h9a8.5 8.5 0 0 1 0 17h-9" stroke-width="6" stroke-linejoin="miter" />
</svg>
