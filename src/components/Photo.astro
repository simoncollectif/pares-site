---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	src: ImageMetadata;
	alt: string;
	ai?: boolean;
	class?: string;
	loading?: 'eager' | 'lazy';
}
const { src, alt, ai = false, class: className, loading = 'lazy' } = Astro.props;
---

<figure class:list={['photo', className]}>
	<Image src={src} alt={alt} widths={[640, 1024, 1600]} sizes="100vw" loading={loading} />
	{ai && <figcaption>Illustratie, gemaakt met AI</figcaption>}
</figure>

<style>
	.photo { margin: 0; position: relative; }
	.photo img { display: block; width: 100%; height: auto; max-height: 82vh; object-fit: cover; }
	figcaption {
		position: absolute;
		right: 10px;
		bottom: 8px;
		font-size: 12px;
		color: rgba(255, 255, 255, 0.75);
		text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
	}
</style>
