---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { rubriekNaam } from '../data/rubrieken';
import Cover from './Cover.astro';

interface Props {
	post: CollectionEntry<'verhalen'>;
}
const { post } = Astro.props;
const { title, description, rubriek, image, imageAlt, vorm } = post.data;
---

<a class="card" href={`/verhalen/${post.id}/`}>
	{
		image ? (
			<Image src={image} alt={imageAlt ?? ''} widths={[480, 800]} sizes="(max-width: 760px) 100vw, 33vw" class="thumb" />
		) : (
			<span class="thumb-wrap" aria-hidden="true">
				<Cover titel={title} label={rubriekNaam(rubriek)} licht={post.id.length % 2 === 0} />
			</span>
		)
	}
	<span class="meta">{rubriekNaam(rubriek)}{vorm === 'kort' && ' · kort'}</span>
	<span class="title">{title}</span>
	<span class="desc">{description}</span>
</a>

<style>
	.card { display: flex; flex-direction: column; gap: 8px; text-decoration: none; padding: 24px var(--gutter) 32px; }
	.card :global(.thumb) { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; display: block; margin-bottom: 8px; }
	.thumb-wrap { display: block; margin-bottom: 8px; }
	.meta { color: var(--accent); font-weight: 600; font-size: 14px; }
	.title { font-family: var(--font-head); font-weight: 700; font-size: 24px; letter-spacing: -0.02em; line-height: 1.1; }
	.desc { color: var(--muted); font-size: 15px; line-height: 1.5; }
	.card:hover .title { color: var(--accent); }
</style>
