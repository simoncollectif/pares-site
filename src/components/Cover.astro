---
// Typografische omslag voor verhalen zonder foto, in de stijl van de Instagram-posts.
import Monogram from './Monogram.astro';

interface Props {
	titel: string;
	label: string;
	licht?: boolean;
	groot?: boolean;
}
const { titel, label, licht = false, groot = false } = Astro.props;
const Titel = groot ? 'h1' : 'span';
---

<div class:list={['cover', { licht, groot }]}>
	<div class="kader">
		<div class="top">
			<span class="label">{label}</span>
			<Monogram size={groot ? 44 : 26} variant={licht ? 'ink' : 'light'} />
		</div>
		<Titel class="titel">{titel}</Titel>
	</div>
</div>

<style>
	.cover { background: var(--ink); color: var(--paper); aspect-ratio: 4 / 3; padding: 14px; display: flex; }
	.cover.licht { background: var(--paper); color: var(--ink); box-shadow: inset 0 0 0 1px var(--line); }
	.cover.groot { aspect-ratio: auto; min-height: 56vh; padding: clamp(16px, 3vw, 40px); }
	.kader { flex: 1; border: 1px solid currentColor; padding: 18px; display: flex; flex-direction: column; justify-content: space-between; }
	.groot .kader { padding: clamp(24px, 4vw, 56px); }
	.top { display: flex; justify-content: space-between; align-items: center; }
	.label { color: var(--accent-on-dark); font-weight: 600; font-size: 14px; }
	.licht .label { color: var(--accent); }
	.groot .label { font-size: 17px; }
	.titel { margin: 0; font-family: var(--font-head); font-weight: 700; letter-spacing: -0.03em; line-height: 1.02; font-size: clamp(18px, 1.9vw, 26px); display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
	.groot .titel { font-size: clamp(44px, 7vw, 104px); max-width: 14ch; -webkit-line-clamp: unset; display: block; }
</style>
